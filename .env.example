# PostgreSQL connection string. Keep this in .env; never put it in VITE_* variables.
DATABASE_URL=postgresql://attendwise_user:change-me@localhost:5432/attendwise
# Public origin(s), comma separated. Use the exact production HTTPS URL in deployment.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PORT=4174
API_HOST=0.0.0.0
SESSION_TTL_HOURS=12
DB_POOL_SIZE=12
# Set PGSSL=require when the managed PostgreSQL provider requires TLS.
PGSSL=disable
NODE_ENV=development